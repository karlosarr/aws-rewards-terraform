# Local .terraform directories
**/.terraform/*

# Local state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which often contain secrets
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
override.tfvars
override.tfvars.json

# Include terraform.tfvars if it's meant to be tracked (usually NOT recommended)
# !terraform.tfvars

# Ignore CLI configuration files
.terraform.lock.hcl
